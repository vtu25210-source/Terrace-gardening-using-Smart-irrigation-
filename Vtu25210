#include <Wire.h>
#include <Adafruit_SSD1306.h>

// Pin Definitions
#define SENSOR_PIN A0    // Soil moisture sensor
#define BUZZER_PIN D6    // Buzzer (GPIO12)
#define PUMP_PIN D7      // Water pump relay (GPIO13) - ACTIVE LOW

const int moistureThreshold = 50;  // Dry soil threshold

// Pump running time (milliseconds)
const int pumpRunTime = 3000;  // 3 seconds

// OLED display setup
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

void setup() {
  Serial.begin(115200);
  
  // Initialize pins
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(PUMP_PIN, OUTPUT);
  
  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(PUMP_PIN, HIGH);  // HIGH = OFF for active-low relay

  // OLED initialization
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED initialization failed!");
    for (;;);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println("Smart Irrigation");
  display.setCursor(0, 25);
  display.println("System Ready!");
  display.display();
  delay(2000);
}

// Function to draw water droplets animation
void drawWaterDrops(int frame) {
  int drop1Y = (frame * 4) % 64;
  int drop2Y = ((frame * 4) + 20) % 64;
  int drop3Y = ((frame * 4) + 40) % 64;
  
  display.fillCircle(30, drop1Y, 2, WHITE);
  display.fillCircle(30, drop1Y + 4, 3, WHITE);
  
  display.fillCircle(60, drop2Y, 2, WHITE);
  display.fillCircle(60, drop2Y + 4, 3, WHITE);
  
  display.fillCircle(90, drop3Y, 2, WHITE);
  display.fillCircle(90, drop3Y + 4, 3, WHITE);
}

// Function to draw animated progress bar
void drawWateringProgress(int progress) {
  display.drawRect(14, 35, 100, 12, WHITE);
  int fillWidth = map(progress, 0, 100, 0, 96);
  display.fillRect(16, 37, fillWidth, 8, WHITE);
  
  display.setTextSize(1);
  display.setCursor(45, 50);
  display.print(progress);
  display.print("%");
}

// Main watering animation function
void wateringAnimation() {
  unsigned long startTime = millis();
  int frame = 0;
  
  while (millis() - startTime < pumpRunTime) {
    display.clearDisplay();
    
    // Title with blinking effect
    if ((frame / 5) % 2 == 0) {
      display.setTextSize(2);
      display.setCursor(10, 5);
      display.println("WATERING");
    }
    
    // Animated water drops
    drawWaterDrops(frame);
    
    // Progress bar
    int progress = map(millis() - startTime, 0, pumpRunTime, 0, 100);
    drawWateringProgress(progress);
    
    display.display();
    frame++;
    delay(50);
  }
}

// Function to display soil moisture level continuously
void displaySoilLevel(float moisturePercent, int sensorValue) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  
  // Title
  display.setCursor(15, 0);
  display.println("SOIL MOISTURE");
  
  // Draw line separator
  display.drawLine(0, 10, 128, 10, WHITE);
  
  // Display moisture percentage (large text)
  display.setTextSize(3);
  display.setCursor(20, 18);
  display.print(moisturePercent, 0);
  display.println("%");
  
  // Draw moisture level bar
  display.setTextSize(1);
  display.setCursor(0, 45);
  display.print("Level:");
  
  int barWidth = map(moisturePercent, 0, 100, 0, 70);
  display.drawRect(40, 44, 72, 10, WHITE);
  display.fillRect(41, 45, barWidth, 8, WHITE);
  
  // Status text
  display.setCursor(0, 57);
  if (moisturePercent < moistureThreshold) {
    display.print("Status: DRY");
  } else if (moisturePercent < 70) {
    display.print("Status: NORMAL");
  } else {
    display.print("Status: WET");
  }
  
  display.display();
}

void loop() {
  // Read sensor value
  int sensorValue = analogRead(SENSOR_PIN);
  float moisturePercent = (1 - (sensorValue / 1200.0)) * 100;

  Serial.print("Raw: ");
  Serial.print(sensorValue);
  Serial.print(" | Soil Moisture: ");
  Serial.print(moisturePercent);
  Serial.println("%");

  // Check if soil is too dry
  if (moisturePercent < moistureThreshold) {
    Serial.println("⚠ Soil is too dry! Activating Buzzer and Pump...");

    // Activate Buzzer
    digitalWrite(BUZZER_PIN, HIGH);
    delay(500);
    digitalWrite(BUZZER_PIN, LOW);
    delay(300);
    digitalWrite(BUZZER_PIN, HIGH);
    delay(500);
    digitalWrite(BUZZER_PIN, LOW);

    // Activate Water Pump with animation
    Serial.println("💧 Pump ON - Watering for 3 seconds...");
    digitalWrite(PUMP_PIN, LOW);  // LOW = ON for active-low relay ✓
    
    wateringAnimation();  // Runs for exactly 3000ms (3 seconds)
    
    digitalWrite(PUMP_PIN, HIGH);  // HIGH = OFF for active-low relay ✓
    Serial.println("💧 Pump OFF - Completed watering cycle");
    
    delay(200);  // Small delay to ensure pump fully stops
    
  } else {
    Serial.println("✓ Soil moisture is sufficient.");
    digitalWrite(PUMP_PIN, HIGH);  // HIGH = OFF (ensure pump stays off) ✓
  }

  // Display soil level for 5 seconds
  Serial.println("Displaying soil level for 5 seconds...");
  unsigned long displayStart = millis();
  
  while (millis() - displayStart < 5000) {
    displaySoilLevel(moisturePercent, sensorValue);
    delay(100);
  }
  
  Serial.println("-----------------------------");
}
